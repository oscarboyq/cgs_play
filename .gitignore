# Local settings and credentials. Keep .env.example templates in Git.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/.aws/
**/secrets/
**/credentials.json
**/service-account*.json
**/service_account*.json
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/api_keys.dart
**/key.properties
**/*.jks
**/*.keystore
**/*.pem
**/*.p8
**/*.p12
**/*.mobileprovision

# Python and Django local files.
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
**/htmlcov/
**/db.sqlite3
**/*.sqlite3
**/staticfiles/
/django/media/

# Flutter, Dart, and Android generated files.
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/.gradle/
**/android/local.properties
**/android/captures/
**/android/.cxx/
**/build/
**/coverage/
**/*.apk
**/*.aab
**/*.ipa

# iOS generated files for the later Apple phase.
**/ios/Pods/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id
**/DerivedData/

# AWS and infrastructure build state.
**/.terraform/
**/*.tfvars
**/*.auto.tfvars
**/terraform.tfstate*
**/cdk.out/
**/.aws-sam/
**/.serverless/
**/node_modules/

# Editor files, logs, database exports, and uploaded video.
**/.idea/
**/.vscode/
**/*.iml
**/*.swp
**/.DS_Store
**/*.log
**/*.dump
**/*.backup
**/*.sql.gz
**/*.mp4
**/*.mov
**/*.m4v
**/*.mkv
**/*.m3u8
**/*.m4s
